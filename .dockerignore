# =============================================================================
# .dockerignore — исключает мусор из Docker build context
# =============================================================================

# --- Python артефакты ---
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/.pytest_cache/
**/*.egg-info/
**/.eggs/

# --- SQLite (база данных разработки, в проде — PostgreSQL) ---
**/*.sqlite3
**/_*.sqlite3

# --- Логи ---
*.log
**/*.log

# --- Виртуальные окружения ---
.venv/
venv/
env/
.env/

# --- Секреты (в образ не должны попадать) ---
# .env НЕ исключаем здесь — он нужен только на хосте рядом с compose,
# в контейнер он и так не копируется (COPY src/ . копирует только src/).
# Но на всякий случай исключаем из корня:
.env

# --- IDE и OS мусор ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Git ---
.git/
.gitignore
.gitattributes

# --- Документация (не нужна в образе) ---
DOCS/
*.md
!requirements*.txt

# --- Тестовые и временные данные ---
sample_data/
tests/
**/tests/

# --- node_modules (на случай если появится фронтенд) ---
node_modules/

# --- Временные файлы ---
tmp/
temp/