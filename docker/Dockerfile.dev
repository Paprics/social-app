# Dockerfile.dev — образ для локальной разработки
#
# Принцип: образ содержит только зависимости.
# Код НЕ копируется — монтируется через volume (../src:/app).
# Это позволяет редактировать файлы на хосте и сразу видеть изменения.

FROM python:3.12-slim

RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Копируем только requirements — слой кешируется отдельно от кода
COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt